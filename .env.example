# ═══════════════════════════════════════════════════════════════
# BIDCONNECT PRO — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# DATABASE (Neon.Tech — PostgreSQL Serverless)
# ─────────────────────────────────────────
# Pooled connection (for Prisma queries via PgBouncer)
DATABASE_URL=postgresql://neondb_owner:[password]@ep-xxxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct connection (for Prisma migrations — bypasses pooler)
DIRECT_URL=postgresql://neondb_owner:[password]@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────
# AUTH (NextAuth.js)
# ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
INVITATION_TOKEN_SECRET=your-invitation-token-secret-min-32-chars
SUPER_ADMIN_SECRET=your-super-admin-header-secret

# ─────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@bidconnect.pro
EMAIL_FROM_NAME=BidConnect Pro

# ─────────────────────────────────────────
# MAPS
# ─────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXX

# ─────────────────────────────────────────
# INNGEST (Background Jobs)
# ─────────────────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ─────────────────────────────────────────
# ERROR MONITORING (Sentry)
# ─────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=bidconnect-pro

# ─────────────────────────────────────────
# ANALYTICS (PostHog)
# ─────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────
# FEATURE FLAGS (Vercel Edge Config)
# ─────────────────────────────────────────
EDGE_CONFIG=https://edge-config.vercel.com/xxxx?token=xxxx

# ─────────────────────────────────────────
# VERCEL
# ─────────────────────────────────────────
VERCEL_TOKEN=your-vercel-token

# ─────────────────────────────────────────
# NEON.TECH PROJECT
# ─────────────────────────────────────────
NEON_PROJECT_ID=your-neon-project-id
NEON_API_URL=https://ep-xxxxx.apirest.us-east-1.aws.neon.tech/neondb/rest/v1

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BidConnect Pro
NODE_ENV=development